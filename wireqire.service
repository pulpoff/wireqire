[Unit]
Description=WireQire - WireGuard VPN Manager
After=network.target wg-quick@wg0.service
Wants=wg-quick@wg0.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/wireqire
EnvironmentFile=/opt/wireqire/.env

# Python virtual environment
ExecStart=/opt/wireqire/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 6000

# Restart policy
Restart=always
RestartSec=5

# Security (adjust as needed - root required for wg commands)
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=false

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wireqire

[Install]
WantedBy=multi-user.target
